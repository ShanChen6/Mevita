{
  "name": "mevita",
  "version": "0.1.0",
  "private": true,
  "description": "Mevita - Hệ thống Quản lý Hồ sơ Y tế Điện tử, Đặt lịch khám & Chuyển tuyến Thời gian thực",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @mevita/web dev",
    "dev:api": "pnpm --filter @mevita/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @mevita/api db:migrate",
    "db:deploy": "pnpm --filter @mevita/api db:deploy",
    "db:seed": "pnpm --filter @mevita/api db:seed",
    "db:studio": "pnpm --filter @mevita/api db:studio",
    "demo:reset": "pnpm --filter @mevita/api demo:reset",
    "demo:video": "node scripts/demo-video/record.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14"
  }
}
