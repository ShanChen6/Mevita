NODE_ENV=development
PORT=4000
# Có thể khai báo nhiều origin, ngăn cách bằng dấu phẩy
CORS_ORIGIN=http://localhost:3000

# Khớp với docker-compose.yml ở thư mục gốc
DATABASE_URL=postgresql://mevita:mevita@localhost:5432/mevita?schema=public

# Khoá ký JWT — tối thiểu 32 ký tự, PHẢI giống JWT_ACCESS_SECRET của apps/web.
# Tạo khoá: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_REUSE_GRACE_SECONDS=30

# Tài khoản demo (chỉ seed khi NODE_ENV khác production)
SEED_DEMO_PASSWORD=Mevita@2026

# Địa chỉ công khai của API — trình duyệt dùng để tải/xem ảnh ở chế độ giả lập
API_PUBLIC_URL=http://localhost:4000/api
# Thư mục lưu ảnh khi CHƯA cấu hình Cloudinary (chế độ giả lập, chỉ dùng khi phát triển)
MEDIA_MOCK_DIR=.uploads

# Ảnh cận lâm sàng. Để trống → dùng kho GIẢ LẬP (không dùng được khi NODE_ENV=production).
# Lấy tại https://console.cloudinary.com -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
