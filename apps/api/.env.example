NODE_ENV=development
PORT=4000
# Có thể khai báo nhiều origin, ngăn cách bằng dấu phẩy
CORS_ORIGIN=http://localhost:3000

# Khớp với docker-compose.yml ở thư mục gốc
DATABASE_URL=postgresql://mevita:mevita@localhost:5432/mevita?schema=public

# Lấy tại https://console.cloudinary.com -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
